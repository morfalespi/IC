{
  "name": "infocardrobot",
  "private": true,
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "scripts": {
    "deploy": "tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "check": "bash scripts/check.sh",
    "start": ".venv/bin/python scripts/ic.py bot",
    "local:run": ".venv/bin/python scripts/ic.py run",
    "test": ".venv/bin/python -m unittest discover -s tests -v && node --experimental-vm-modules tests/tgcloud.test.cjs",
    "demo": ".venv/bin/python tests/run_controlled.py"
  }
}
