# Load explicitly into your shell; never commit a populated .env.
BOT_TOKEN=
API_ID=
API_HASH=
# Required for the polling bot. Comma-separated canonical IDs; empty denies access.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
# Single-run acquisition: explicit target and optional authorized destination.
ALVO=
EXPECTED_ID=
CHAT_ID=
MODO=completo
# Optional category selection; empty uses the selected mode's core categories.
IC_CATEGORIES=
MESSAGE_ID=
MESSAGE_IDS=
IC_MAX_PAGES=1000
IC_MAX_MEDIA_BYTES=41943040
IC_STATE_DIR=.ic
IC_OUTPUT_DIR=.ic/exports
TELETHON_SESSION_DIR=.ic/sessions
# Optional: already-authorized Telethon user StringSession. Keep secret.
TELETHON_STRING_SESSION=
# Reuse a stable operation ID only when reconciling/retrying the SAME logical run.
IC_OPERATION_ID=
# Optional hosted deployment credentials, independent of local operation.
TGCLOUD_TOKEN=
GH_DISPATCH_TOKEN=
